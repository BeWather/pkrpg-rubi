// Utilidades de la GBA compartidas por los shaders de las transiciones de batalla.
// gSineTable (src/trig.c de pokeruby): 256 * sin(i * PI / 128) truncado.
const int SENO_GBA[256] = {
	0, 6, 12, 18, 25, 31, 37, 43, 49, 56, 62, 68, 74, 80, 86, 92,
	97, 103, 109, 115, 120, 126, 131, 136, 142, 147, 152, 157, 162, 167, 171, 176,
	181, 185, 189, 193, 197, 201, 205, 209, 212, 216, 219, 222, 225, 228, 231, 234,
	236, 238, 241, 243, 244, 246, 248, 249, 251, 252, 253, 254, 254, 255, 255, 255,
	256, 255, 255, 255, 254, 254, 253, 252, 251, 249, 248, 246, 244, 243, 241, 238,
	236, 234, 231, 228, 225, 222, 219, 216, 212, 209, 205, 201, 197, 193, 189, 185,
	181, 176, 171, 167, 162, 157, 152, 147, 142, 136, 131, 126, 120, 115, 109, 103,
	97, 92, 86, 80, 74, 68, 62, 56, 49, 43, 37, 31, 25, 18, 12, 6,
	0, -6, -12, -18, -25, -31, -37, -43, -49, -56, -62, -68, -74, -80, -86, -92,
	-97, -103, -109, -115, -120, -126, -131, -136, -142, -147, -152, -157, -162, -167, -171, -176,
	-181, -185, -189, -193, -197, -201, -205, -209, -212, -216, -219, -222, -225, -228, -231, -234,
	-236, -238, -241, -243, -244, -246, -248, -249, -251, -252, -253, -254, -254, -255, -255, -255,
	-256, -255, -255, -255, -254, -254, -253, -252, -251, -249, -248, -246, -244, -243, -241, -238,
	-236, -234, -231, -228, -225, -222, -219, -216, -212, -209, -205, -201, -197, -193, -189, -185,
	-181, -176, -171, -167, -162, -157, -152, -147, -142, -136, -131, -126, -120, -115, -109, -103,
	-97, -92, -86, -80, -74, -68, -62, -56, -49, -43, -37, -31, -25, -18, -12, -6
};

// Sin(angulo, amplitud) de pokeruby: (amplitud * gSineTable[angulo]) >> 8.
int sin_gba(int angulo, int amplitud) {
	return (amplitud * SENO_GBA[angulo & 255]) >> 8;
}

// Resto positivo: los fondos de la GBA envuelven al desplazarse.
int envolver(int valor, int modulo) {
	int resto = valor % modulo;
	return resto < 0 ? resto + modulo : resto;
}

// Pixel GBA (0..239, 0..159) del fragmento a partir de SCREEN_UV.
ivec2 pixel_gba(vec2 screen_uv, vec2 screen_pixel_size) {
	return ivec2(floor(screen_uv / screen_pixel_size));
}
