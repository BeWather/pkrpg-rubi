[ext_resource type="Script" path="res://scripts/evolucion/animacion_evolucion.gd" id="1_script"]

[sub_resource type="Shader" id="Shader_blanco"]
code = "shader_type canvas_item;
uniform float blanco : hint_range(0.0, 1.0) = 0.0;
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	COLOR = vec4(mix(c.rgb, vec3(1.0), blanco), c.a);
}
"

