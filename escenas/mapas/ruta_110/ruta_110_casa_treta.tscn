[node name="Cortina" type="Sprite2D" parent="Carteles" unique_id=1320012001 groups=["Cartel"]]
editor_description = "pokeruby Route110_TrickHouseEntrance bg_event (5,1) sign BG_EVENT_PLAYER_FACING_NORTH, Route110_TrickHouseEntrance_EventScript_Door: la cortina (solo mirando al norte). La resuelve Eventos/EventoCasaTreta."
position = Vector2(88, 24)
script = ExtResource("ct_cartel_evento")
capa_datos = 0
id_texto = "CASA_TRETA_ENTRADA_CORTINA"
coord_tile = Vector2i(5, 1)
direccion = 1

[node name="NPCs" type="Node2D" parent="." unique_id=491424303]
z_index = 1
y_sort_enabled = true

[node name="Maestro" parent="NPCs" unique_id=1320012010 instance=ExtResource("ct_npc_base")]
editor_description = "pokeruby Route110_TrickHouseEntrance objeto 1 (6,2) MAN_1 FACE_LEFT, FLAG_HIDE_TRICKMASTER_ENTRANCE: el MAESTRO TRETA de la ENTRADA. Su celda y visibilidad las decide Eventos/EventoCasaTreta segun ENTRANCE_STATE_3 (escondido, junto a la cortina o ausente)."
position = Vector2(104, 46)
script = ExtResource("ct_npc_evento")
id_texto = "CASA_TRETA_ENTRADA_CORTINA"
selec_frames = ExtResource("ct_npc_048")
coord = Vector2i(6, 2)

[node name="MaestroFinal" parent="NPCs" unique_id=1320012011 instance=ExtResource("ct_npc_base")]
editor_description = "pokeruby Route110_TrickHouseEnd objeto 1 (4,5)+(19,0) MAN_1 FACE_RIGHT, FLAG_HIDE_TRICK_HOUSE_END_MAN: el MAESTRO TRETA del FINAL. Solo esta al llegar por la puerta de una prueba."
position = Vector2(376, 94)
script = ExtResource("ct_npc_evento")
id_texto = "CASA_TRETA_FIN_LLEGASTE"
tipo_movimiento = 10
selec_frames = ExtResource("ct_npc_048")
coord = Vector2i(23, 5)

[node name="PepitaOculta" parent="NPCs" unique_id=1320012012 instance=ExtResource("ct_item")]
editor_description = "pokeruby Route110_TrickHouseEnd bg_hidden_item_event (4,5)+(19,0) ITEM_NUGGET, FLAG_HIDDEN_ITEM_1 (0x259): activa = ya recogida; se pone al cargar el FINAL y se borra al terminar el 8.o acertijo. Eventos/EventoCasaTreta la habilita."
position = Vector2(376, 94)
id_item = "casa_treta_pepita_01"
objeto_a_entregar = "PEPITA"
oculto = true
coord = Vector2i(23, 5)

[node name="Eventos" type="Node2D" parent="." unique_id=1320006000]

[node name="EventoCasaTreta" type="Node2D" parent="Eventos" unique_id=1320012020]
editor_description = "pokeruby Route110_TrickHouseEntrance/End/Corridor: OnTransition, OnWarp, OnFrame, MAESTRO, cortina, destello y premios. Las tres salas comparten escena: Entrada (0,0), Final (+19,0), Pasillo (+38,0); la sala se decide por la celda de llegada del warp."
script = ExtResource("ct_evento")
maestro = NodePath("../../NPCs/Maestro")
maestro_final = NodePath("../../NPCs/MaestroFinal")
cortina = NodePath("../../Carteles/Cortina")
pepita = NodePath("../../NPCs/PepitaOculta")
capa_suelo = NodePath("../../Suelo")
datos_tiles = NodePath("../../TPTileDataMap")

[node name="Observa" parent="Eventos/EventoCasaTreta" unique_id=1320012021 instance=ExtResource("ct_disparador")]
editor_description = "coord_events trigger (4,7), (5,6), (6,6) y (7,7) de Route110_TrickHouseEntrance con VAR_TRICK_HOUSE_ENTRANCE_STATE == 0 (TrickMasterHiding): Te estoy observando y destello."
id_evento = &"observa"
zonas_tiles = Array[Rect2i]([Rect2i(4, 7, 1, 1), Rect2i(5, 6, 2, 1), Rect2i(7, 7, 1, 1)])

[node name="SalidaFinal" parent="Eventos/EventoCasaTreta" unique_id=1320012022 instance=ExtResource("ct_disparador")]
editor_description = "coord_event trigger (2,2)+(19,0) de Route110_TrickHouseEnd con VAR_TEMP_2 == 0 (TrickMasterExitTrigger): no se sale sin hablar con el MAESTRO."
id_evento = &"salida_final"
zonas_tiles = Array[Rect2i]([Rect2i(21, 2, 1, 1)])

