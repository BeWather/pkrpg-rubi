npc_id = "villa_raiz_prueba_disfraz_montana"
entrenador_id = 416
rango_vision = 3
texto_post_combate = "Mi ataque sorpresa ha sido un fiasco..."
id_texto = "¡Si no estás en guardia, te espera
una buena tunda!"
tipo_movimiento = 61
rango = Vector2i(0, 0)
capa_datos = 0
selec_frames = ExtResource("20_5y54e")
coord = Vector2i(45, 33)
