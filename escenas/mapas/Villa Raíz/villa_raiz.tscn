[node name="PruebaDisfrazArbol" parent="NPCs" unique_id=1301000013 instance=ExtResource("7_5hyw1")]
editor_description = "Zona de pruebas: MOVEMENT_TYPE_TREE_DISGUISE. Copia de YASU (pokeruby Route119 objeto 12, CHICO NINJA, visión 2): se quita el disfraz al ver al jugador o al hablarle."
position = Vector2(648, 558)
npc_id = "villa_raiz_prueba_disfraz_arbol"
entrenador_id = 415
rango_vision = 2
texto_post_combate = "Aquellos que pierden un combate han
de volver silenciosos a las sombras...\\w
El destino lo quiere así..."
id_texto = "Acechar entre las sombras, vivir en
la oscuridad... Ése es mi destino...\\p¡Y ahora salgo a la luz para retarte!"
tipo_movimiento = 60
rango = Vector2i(0, 0)
capa_datos = 0
selec_frames = ExtResource("20_5y54e")
coord = Vector2i(40, 34)
loggear = false

[node name="PruebaDisfrazMontana" parent="NPCs" unique_id=1301000014 instance=ExtResource("7_5hyw1")]
editor_description = "Zona de pruebas: MOVEMENT_TYPE_MOUNTAIN_DISGUISE. Copia de TAKASHI (pokeruby Route119 objeto 13, CHICO NINJA, visión 3)."
