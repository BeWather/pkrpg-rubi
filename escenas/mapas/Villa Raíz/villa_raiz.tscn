entrenador_id = 419
rango_vision = 1
ver_en_todas_direcciones = true
texto_post_combate = "Tengo que perfeccionar mi técnica
de camuflaje.\\p¡Me piro, vampiro!"
id_texto = "¡Surjo de entre las cenizas como una
sombra! ¡Kiaaaaaaaaa!\\w
¿Aceptas mi desafío?"
tipo_movimiento = 66
rango = Vector2i(0, 0)
