[node name="PruebaOculto" parent="NPCs" unique_id=1301000015 instance=ExtResource("7_5hyw1")]
editor_description = "Zona de pruebas: MOVEMENT_TYPE_HIDDEN. Copia de LAO (pokeruby Route113 objeto 8, CHICO NINJA enterrado en ceniza, TRAINER_TYPE_BURIED, visión 1): ve en las cuatro direcciones y sale de la ceniza al estar al lado."
position = Vector2(872, 574)
