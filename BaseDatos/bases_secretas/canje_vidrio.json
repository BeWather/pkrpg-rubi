	"textos": [
		{
			"clave": "VIDRIO_COMPROBAR",
			"direccion": "0x081A18F5",
			"raw_hex": "51C2D5E700E6D9D7E3DBDDD8E300D7D9E2DDEED5ACB80052D5D7DC6FE7ABFEBB00EAD9E6ADADAD0052BBD7DC6FE7B800D5D7DC6FE7ABFF",
			"texto_es": "¿Has recogido ceniza?, ¡achís!\nA ver... ¡Achís, achís!"
		},
		{
			"clave": "VIDRIO_POCA_CENIZA",
			"direccion": "0x081A192C",
			"raw_hex": "",
			"texto_es": "Mmmm...\nNo hay bastante ceniza, ¡achís!\\w\\nNo puedo hacer cristal con esto...\\pA ver... Tienes que dar {pasos} pasos para\nrecoger suficiente ceniza y que yo\\w\\npueda hacerte una FLAUTA AZUL, ¡achís!"
		},
		{
			"clave": "VIDRIO_SUFICIENTE",
			"direccion": "0x081A19E7",
			"raw_hex": "52C9DCABFECEDDD9E2D9E700E9E200E1E3E2E823E200D8D900D7D9E2DDEED5B80052D5D7DC6FE7ABFBCED900EAE3ED00D500DCD5D7D9E600E9E200E3D6DED9E8E300D8D900D7E6DDE7E8D5E0ADADADFE51BDE917E000E5E9DDD9E6D9E7AC0052BBD7DC6FE7ABFF",
			"texto_es": "¡Oh!\nTienes un montón de ceniza, ¡achís!\\pTe voy a hacer un objeto de cristal...\n¿Cuál quieres? ¡Achís!"
		},
		{
			"clave": "VIDRIO_CONFIRMAR",
			"direccion": "0x081A1A4E",
			"raw_hex": "51CFE2D500FD02ACB80052D5D7DC6FE7ABFE51CDD9DBE9E6E300E5E9D900D9E700D9E7E3AC005252BBBDC25ACDABABFF",
			"texto_es": "¿Una {nombre}?, ¡achís!\n¿Seguro que es eso? ¡¡ACHÍS!!"
		},
		{
			"clave": "VIDRIO_ELEGIR",
			"direccion": "0x081A1A7E",
			"raw_hex": "51BDE917E000E5E9DDD9E6D9E7AC0052BBD7DC6FE7ABFF",
			"texto_es": "¿Cuál quieres? ¡Achís!"
		},
		{
			"clave": "VIDRIO_ESPERAR",
			"direccion": "0x081A1A95",
			"raw_hex": "D0D5E0D9B800E9E2D500FD0200D9E2E8E3E2D7D9E7B8FE52D5D7DC6FE7ABFBCED900E0D500DCD5DBE300D9E200E9E200E1DDE2E9E8E3B80052D5D7DC6FE7ABFECED9E200E9E200E4E3D7E300D8D900E4D5D7DDD9E2D7DDD5B80052BBBDC25ACDABFF",
			"texto_es": "Vale, una {nombre} entonces,\n¡achís!\\pTe la hago en un minuto, ¡achís!\nTen un poco de paciencia, ¡ACHÍS!"
		},
		{
			"clave": "VIDRIO_FALTAN",
			"direccion": "0x081A1AF7",
			"raw_hex": "",
			"texto_es": "¿Una {nombre}?, ¡achís!\\pNo tienes bastante ceniza para hacer\neso, lo siento, ¡achís, achís!\\pA ver... Tienes que dar {pasos} pasos para\nrecoger suficiente ceniza y que yo\\w\\npueda hacerte ese objeto, ¡achís!\\p¿Quieres que te haga otro objeto\nen vez de ése? ¡¡¡ACHÍS!!!"
		},
		{
			"clave": "VIDRIO_SALIR",
			"direccion": "0x081A1BF4",
			"raw_hex": "51C2D5E700E6D9D7E3DBDDD8E300E8E3D8D500D9E7D500D7D9E2DDEED500ED00D5DCE3E6D5FEE2E300E5E9DDD9E6D9E700E2D5D8D500D8D900E2D5D8D5B800D5D7DC6FE7ACFF",
			"texto_es": "¿Has recogido toda esa ceniza y ahora\nno quieres nada de nada, achís?"
		},
		{
			"clave": "VIDRIO_TERMINADO",
			"direccion": "0x081A1C3A",
			"raw_hex": "C2D900D5D7D5D6D5D8E300E8E900FD02ADFECEE3E1D5B800E4D5E6D500E8DDB80052D5D7DC6FE7ABFF",
			"texto_es": "He acabado tu {nombre}.\nToma, para ti, ¡achís!"
		},
		{
			"clave": "VIDRIO_SIN_MOCHILA",
			"direccion": "0x081A1C63",
			"raw_hex": "51BD23E1E3ACFE52CDDD00E2E300E8DDD9E2D9E700E7DDE8DDE300D9E200E0D500C7C9BDC2C3C6BBB800D5D7DC6FE7ABFBCED900EAE3ED00D500DBE9D5E6D8D5E600D9E7E8E3B800D5E76F00E5E9D900EAE9D9E0EAD9FED7E9D5E2D8E300E5E9DDD9E6D5E7B8005252BBBDC25ACDABABFF",
			"texto_es": "¿Cómo?\n¡Si no tienes sitio en la MOCHILA, achís!\\pTe voy a guardar esto, así que vuelve\ncuando quieras, ¡¡ACHÍS!!"
		},
		{
			"clave": "VIDRIO_SIN_PC",
			"direccion": "0x081A1CD4",
			"raw_hex": "51BD23E1E3ACFE52CDDD00E2E300E8DDD9E2D9E700E7DDE8DDE300D9E200D9E000CABDB800D5D7DC6FE7ABFBCED900EAE3ED00D500DBE9D5E6D8D5E600D9E7E8E3B800D5E76F00E5E9D900EAE9D9E0EAD9FED7E9D5E2D8E300E5E9DDD9E6D5E7B8005252BBBDC25ACDABABFF",
			"texto_es": "¿Cómo?\n¡Si no tienes sitio en el PC, achís!\\pTe voy a guardar esto, así que vuelve\ncuando quieras, ¡¡ACHÍS!!"
		},
		{
			"clave": "VIDRIO_SIN_SACO",
			"direccion": "0x081A1D40",
			"raw_hex": "51BD23E1E3AC0052CDDD00E2E300E0E0D9EAD5E700D9E000CDBBBDC9FEC2C9C6C65AC800D7E3E2E8DDDBE3B800D5D7DC6FE7ABFBC6E300E2D9D7D9E7DDE8D5E700E4D5E6D500E4E3D8D9E600E6D9D7E3DBD9E6FED7D9E2DDEED500EAE3E0D717E2DDD7D5B8005252BBBDC25ACDABABFF",
			"texto_es": "¿Cómo? ¡Si no llevas el SACO\nHOLLÍN contigo, achís!\\pLo necesitas para poder recoger\nceniza volcánica, ¡¡ACHÍS!!"
