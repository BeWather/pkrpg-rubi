; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pokemon Rubi"
config/version="1.0.0"
run/main_scene="uid://cyo25mfcqx578"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://02lgpalls3rx"

[autoload]

Singleton="*res://scripts/singleton.gd"
SistemaGuardado="*res://scripts/sistema_guardado.gd"
DatabaseManager="*res://BaseDatos/database_manager.gd"
DialogManager="*res://scripts/dialog_manager.gd"
McpInteractionServer="*res://dev/mcp/mcp_interaction_server.gd"
DebugArranque="*res://dev/debug_arranque.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=480
window/stretch/mode="viewport"
window/stretch/scale=3.0

[dotnet]

project/assembly_name="Pokemon Rubi"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/lapiz_flores/plugin.cfg", "res://addons/tile_data_map_plugin/plugin.cfg", "res://addons/tilemap_inspector/plugin.cfg")

[filesystem]

exclude_dirs="//.cpp_modules,//.sinusar,//documentacion,//Audio/BGM,//Audio/BGS,//Audio/emerald,//Audio/ME,//Audio/music,//Audio/SE"

[gdunit4]

hooks/session_hooks=Dictionary[String, bool]({
"res://test/hooks/animaciones_vm_por_defecto_hook.gd": true
})

[importer_defaults]

font_data_dynamic={
&"antialiasing": 0,
&"hinting": 0,
&"subpixel_positioning": 0
}

