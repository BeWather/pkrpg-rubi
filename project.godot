[internationalization]

locale/translations=PackedStringArray("res://BaseDatos/dialogos.es.translation", "res://BaseDatos/dialogos.en.translation", "res://BaseDatos/bases_secretas/decoraciones.es.translation", "res://BaseDatos/bases_secretas/decoraciones.en.translation", "res://BaseDatos/bases_secretas/ciclo.es.translation", "res://BaseDatos/bases_secretas/ciclo.en.translation", "res://BaseDatos/bases_secretas/pc.es.translation", "res://BaseDatos/bases_secretas/pc.en.translation", "res://BaseDatos/maquinas/textos_maquinas.es.translation", "res://BaseDatos/maquinas/textos_maquinas.en.translation", "res://BaseDatos/bases_secretas/regalo_mt43.es.translation", "res://BaseDatos/bases_secretas/regalo_mt43.en.translation", "res://BaseDatos/bases_secretas/canje_vidrio.es.translation", "res://BaseDatos/bases_secretas/canje_vidrio.en.translation", "res://BaseDatos/concursos/textos_concurso.es.translation", "res://BaseDatos/concursos/textos_concurso.en.translation")
